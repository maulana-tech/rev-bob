# CDE-AI Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=production

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=

# IBM watsonx.ai (Granite models)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM watsonx Orchestrate (Deployed Agent)
ORCHESTRATE_API_KEY=
ORCHESTRATE_AGENT_ID=cb3cf0d3-1441-43b6-b8f4-05e08642c936
ORCHESTRATE_REGION=au-syd

# Jira Cloud (Direct Integration)
JIRA_HOST=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=

# GitHub
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/github/callback

# Frontend URL (IMPORTANT: Set to your Vercel URL for production)
FRONTEND_URL=https://your-app.vercel.app
APP_URL=https://your-backend.railway.app

# Optional: Custom LLM
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# NVIDIA AI (Fallback LLM)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
