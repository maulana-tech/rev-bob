# Rev BOB Backend Configuration
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# Server URLs
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# NVIDIA AI (Primary LLM Provider)
# Get free API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# IBM Watson Orchestrate (Optional)
ORCHESTRATE_API_KEY=your_orchestrate_api_key_here
ORCHESTRATE_AGENT_ID=your_agent_id_here
ORCHESTRATE_URL=https://au-syd.watson-orchestrate.cloud.ibm.com

# Jira Integration (Optional)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# GitHub OAuth (for private repo access)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/github/callback

# Alternative LLM Providers (Optional)
GLM_API_KEY=your_glm_api_key_here
ASI_ONE_API_KEY=your_asi_one_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here